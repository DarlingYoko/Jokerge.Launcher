<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Gml.Launcher.Views.Components"
        xmlns:avalonia="clr-namespace:TheArtOfDev.HtmlRenderer.Avalonia;assembly=Avalonia.HtmlRenderer">
    <Design.PreviewWith>
        <controls:NewsComponent />
    </Design.PreviewWith>

    <Style Selector="controls|NewsComponent">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <controls:StackFrameBorder Padding="20" Spacing="8">
                    <TextBlock Classes="HeadlineText" FontSize="18" TextWrapping="Wrap" Text="{TemplateBinding Title}" />
                    <avalonia:HtmlPanel x:Name="HtmlPanel" Text="{TemplateBinding Description}" />
                    <TextBlock Classes="FormText"
                               FontSize="12"
                               Margin="0"
                               IsVisible="{Binding Date, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Text="{Binding Date, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" />
                </controls:StackFrameBorder>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>

