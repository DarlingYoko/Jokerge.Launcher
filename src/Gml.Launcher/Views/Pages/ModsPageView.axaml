<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:components="clr-namespace:Gml.Launcher.Views.Components"
             xmlns:vm="clr-namespace:Gml.Launcher.ViewModels.Pages"
             xmlns:lang="clr-namespace:Gml.Launcher.Assets.Resources"
             xmlns:cvm="clr-namespace:Gml.Launcher.ViewModels.Components"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Gml.Launcher.Views.Pages.ModsPageView"
             x:DataType="vm:ModsPageViewModel">
    <Grid>
        <!-- Background -->
        <components:BackgroundComponent Classes="Image" Source="/Assets/Images/background.jpg" />
        <Rectangle Fill="{DynamicResource BackgroundOverlay}" />

        <Border Padding="20">
            <Grid RowDefinitions="Auto, 30, *">

                <!-- Navigation -->
                <Grid Grid.ColumnSpan="3" Grid.Row="0">
                    <components:GmlButton Classes="TextIcon Additional"
                                          Padding="15, 0, 20 ,0"
                                          IconPath="/Assets/Images/back.svg"
                                          IconSize="22"
                                          Text="{x:Static lang:Resources.Back}"
                                          Command="{Binding GoBackCommand}" />
                </Grid>


                <Grid Grid.Row="2" ColumnDefinitions="300, 20, *">
                    <components:StackFrameBorder Grid.Column="0"
                                                 Spacing="10"
                                                 VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0, 0, 0, 10"
                                    Spacing="10">
                            <Svg Path="/Assets/Images/folder.svg"
                                 Width="28"
                                 Height="28" />
                            <TextBlock Text="{x:Static lang:Resources.ModsList}"
                                       Classes="HeadlineText"
                                       Margin="0"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="{x:Static lang:Resources.ModsListDescription}"
                                   TextWrapping="Wrap"
                                   Margin="38, 0, 0, 0"
                                   LineHeight="25"
                                   Classes="FormText" />


                    </components:StackFrameBorder>

                    <components:StackFrameBorder Grid.Column="2"
                                                 Spacing="10"
                                                 VerticalAlignment="Top"
                                                 IsVisible="{Binding ModsListIsEmpty}">

                        <StackPanel Spacing="10">

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        Spacing="10">
                                <Svg Path="/Assets/Images/folder.svg" Width="48"/>
                                <TextBlock Classes="HeadlineText"
                                           Margin="0, 5, 0, 0"
                                           VerticalAlignment="Center"
                                           Text="{x:Static lang:Resources.Empty}" />
                            </StackPanel>

                            <TextBlock Classes="FormText"
                                       TextWrapping="Wrap"
                                       Text="{x:Static lang:Resources.ModsEmpty}" />
                        </StackPanel>
                    </components:StackFrameBorder>

                    <ScrollViewer Grid.Column="2">
                        <ItemsControl x:Name="ModsListControl"
                                      ItemsSource="{Binding ProfileOptionalMods}">
                            <ItemsControl.DataTemplates>
                                <DataTemplate x:DataType="cvm:OptionalModItemViewModel">

                                    <components:StackFrameBorder Margin="0, 0, 0, 10"
                                                                 Spacing="10"
                                                                 VerticalAlignment="Top">
                                        <Grid ColumnDefinitions="Auto, 20, *">
                                            <CheckBox CommandParameter="{Binding .}"
                                                      Command="{Binding ((vm:ModsPageViewModel)DataContext).ChangeOptionalModState, ElementName=ModsListControl}"
                                                      IsChecked="{Binding IsSelected}"
                                                      IsEnabled="{Binding CanToggle}"
                                                      VerticalAlignment="Top"
                                                      Classes="FormCheckBox" />

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Spacing="3">
                                                <TextBlock Foreground="{DynamicResource HeadlineColor}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Title}" />
                                                <TextBlock Foreground="{DynamicResource ContentColor}"
                                                           TextWrapping="Wrap"
                                                           MinWidth="145"
                                                           LineHeight="20"
                                                           FontSize="12"
                                                           Text="{Binding Description}" />

                                                <!-- Mods turned on together with this one, inside its card -->
                                                <Border Margin="0, 10, 0, 0"
                                                        Padding="14, 2, 0, 2"
                                                        BorderThickness="2, 0, 0, 0"
                                                        BorderBrush="{DynamicResource ContentColor}"
                                                        IsVisible="{Binding HasDependencies}">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Foreground="{DynamicResource ContentColor}"
                                                                   FontSize="12"
                                                                   Opacity="0.8"
                                                                   Text="{Binding ((vm:ModsPageViewModel)DataContext).DependenciesTitle, ElementName=ModsListControl}" />
                                                        <ItemsControl ItemsSource="{Binding Dependencies}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Spacing="10" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="cvm:DependencyRow">
                                                                    <Grid Margin="{Binding Indent}"
                                                                          ColumnDefinitions="Auto, 14, *">
                                                                        <CheckBox CommandParameter="{Binding Mod}"
                                                                                  Command="{Binding ((vm:ModsPageViewModel)DataContext).ChangeOptionalModState, ElementName=ModsListControl}"
                                                                                  IsChecked="{Binding Mod.IsSelected}"
                                                                                  IsEnabled="{Binding Mod.CanToggle}"
                                                                                  VerticalAlignment="Top"
                                                                                  Classes="FormCheckBox" />
                                                                        <StackPanel Grid.Column="2"
                                                                                    VerticalAlignment="Center"
                                                                                    Spacing="2">
                                                                            <TextBlock Foreground="{DynamicResource HeadlineColor}"
                                                                                       FontSize="13"
                                                                                       FontWeight="SemiBold"
                                                                                       Text="{Binding Mod.Title}" />
                                                                            <TextBlock Foreground="{DynamicResource ContentColor}"
                                                                                       TextWrapping="Wrap"
                                                                                       LineHeight="18"
                                                                                       FontSize="12"
                                                                                       Text="{Binding Mod.Description}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Locked on because an enabled mod needs it -->
                                                <TextBlock Foreground="{DynamicResource ContentColor}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12"
                                                           Opacity="0.8"
                                                           Margin="0, 6, 0, 0"
                                                           IsVisible="{Binding HasNeededBy}"
                                                           Text="{Binding NeededByText}" />
                                            </StackPanel>

                                        </Grid>

                                    </components:StackFrameBorder>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </ScrollViewer>

                </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
